# Copy to frontend/.env.local to use the real backend. No secrets belong here.
#
# Option A (recommended for development): same origin. The Vite dev server proxies /api to
# http://localhost:8000 (see vite.config.js), so there is no CORS to configure.
VITE_USE_BACKEND=true

# Option B: call the backend directly. The backend's CORS_ORIGINS must include this page's origin.
# VITE_API_URL=http://localhost:8000

# With neither set, the app runs against the in-browser mock (services/mockServer.js).
