# Proposed configuration. Copy to .env and edit. Never commit .env.
# No real secrets belong in this file.

# Ollama (local model server)
OLLAMA_HOST=http://localhost:11434
# Model tag to run. gemma4:e2b is the smallest Gemma 4 on Ollama (about 5-7 GB download).
# Pull it once with: ollama pull gemma4:e2b
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=60

# Backend
DATABASE_PATH=./prompt_heist.db
# Allowed frontend origin(s), comma separated. Adjust to the chosen frontend dev server.
CORS_ORIGINS=http://localhost:5173

# Frontend: backend base URL. The variable name depends on the chosen framework
# (for example VITE_API_BASE_URL for Vite). Add it here once the framework is chosen.
